<Window x:Class="WpfVirement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfVirement"
        mc:Ignorable="d"
        Title="Virement" Height="420" Width="700">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Compte à débiter" FontWeight="Bold" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="10,0"
                  ItemsSource="{Binding Comptes}" DisplayMemberPath="IdCompte"
                  SelectedItem="{Binding CompteDebit}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Compte à créditer" FontWeight="Bold" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="10,0"
                  ItemsSource="{Binding Comptes}" DisplayMemberPath="IdCompte"
                  SelectedItem="{Binding CompteCredit}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Montant" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="10,0"
                 Text="{Binding Montant, UpdateSourceTrigger=PropertyChanged}"/>

        <Button x:Name="Valider_Button" Grid.Row="3" Grid.Column="0" Margin="10" Content="Valider" Click="Valider_Button_Click"/>
        <Button x:Name="Annuler_Button" Grid.Row="3" Grid.Column="1" Margin="10" Content="Annuler" Click="Annuler_Button_Click"/>

        <Button x:Name="AjouterCompte_Button" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="10" Content="Ajouter un compte" Click="AjouterCompte_Button_Click"/>
    </Grid>
</Window>
